#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
python_bin="${PYTHON:-python3}"
venv_dir="${PICAR_VENV:-$repo_dir/venv}"

if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required for apt packages and Raspberry Pi boot config changes." >&2
    exit 1
fi

echo "Installing Raspberry Pi OS packages..."
sudo apt-get update
sudo apt-get install -y \
    git \
    i2c-tools \
    python3-opencv \
    python3-pip \
    python3-smbus \
    python3-venv

echo "Creating virtual environment at $venv_dir"
"$python_bin" -m venv --system-site-packages "$venv_dir"
"$venv_dir/bin/python" -m pip install --upgrade pip setuptools wheel
"$venv_dir/bin/python" -m pip install -r "$repo_dir/requirements.txt"
"$venv_dir/bin/python" -m pip install "git+https://github.com/sunfounder/SunFounder_PiCar.git"

config_file=""
for candidate in /boot/firmware/config.txt /boot/config.txt; do
    if [ -f "$candidate" ]; then
        config_file="$candidate"
        break
    fi
done

if [ -n "$config_file" ]; then
    if grep -Eq '^[[:space:]]*dtparam=i2c_arm=on' "$config_file"; then
        echo "I2C is already enabled in $config_file"
    else
        echo "Enabling I2C in $config_file"
        echo "dtparam=i2c_arm=on" | sudo tee -a "$config_file" >/dev/null
        echo "Reboot is required for I2C changes to take effect."
    fi
else
    echo "No Raspberry Pi boot config found. Enable I2C with raspi-config if needed."
fi

if id -nG "$USER" | grep -qw i2c; then
    echo "User $USER is already in group i2c"
else
    echo "Adding $USER to i2c, gpio, and video groups"
    sudo usermod -aG i2c,gpio,video "$USER"
    echo "Log out/in or reboot for group changes to take effect."
fi

echo ""
echo "Install complete."
echo "Run the server with:"
echo "  cd $repo_dir/remote_control"
echo "  ../venv/bin/python manage.py runserver 0.0.0.0:8000"
